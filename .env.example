# Responsable: Gabriel Alvarez Mendoza (Arquitecto de Datos / Lider)
# Plantilla de variables. Copiala a .env (PowerShell: Copy-Item .env.example .env) y cambia las contrasenas.
# .env esta en .gitignore: nunca se versiona ni se imprime.

# --- MinIO: usuario raiz (solo lo usan minio y minio-init; en F1 tambien el lakehouse) ---
MINIO_ROOT_USER=lakehouse-admin
# Minimo 8 caracteres.
MINIO_ROOT_PASSWORD=cambia-esta-contrasena

# --- Spark ---
# Memoria del driver (Spark corre en modo local dentro del contenedor).
SPARK_DRIVER_MEMORY=4g

# --- Logs: DEBUG, INFO, WARNING o ERROR ---
LOG_LEVEL=INFO

# --- Datos de Spotify (F2) ---
# Carpeta con los JSON reales (gitignored). En un clon sin datos se usan los sinteticos.
SPOTIFY_DATA_DIR=./DATOS_SPOTIFY
