# Responsable: Gabriel Alvarez Mendoza (Arquitecto de Datos / Lider)
# Plantilla de variables. Copiala a .env (PowerShell: Copy-Item .env.example .env) y cambia las contrasenas.
# .env esta en .gitignore: nunca se versiona ni se imprime.

# --- MinIO: usuario raiz (solo lo usan minio y minio-init; nunca entra al contenedor del pipeline) ---
MINIO_ROOT_USER=lakehouse-admin
# Minimo 8 caracteres.
MINIO_ROOT_PASSWORD=cambia-esta-contrasena

# --- MinIO: un usuario por servicio con permisos minimos (D17) ---
# svc-ingestion, svc-transformation, svc-governance, svc-ml y svc-bi. minio-init los crea con estas contrasenas.
# PowerShell (las agrega a .env sin imprimirlas):
#   foreach ($r in 'INGESTION','TRANSFORMATION','GOVERNANCE','ML','BI') {
#     $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     Add-Content .env ("MINIO_SECRET_$r=" + (-join ($b | ForEach-Object { $_.ToString('x2') }))) }
# (Van comentadas aqui para que el comando de arriba sea la unica definicion en tu .env.)
# MINIO_SECRET_INGESTION=
# MINIO_SECRET_TRANSFORMATION=
# MINIO_SECRET_GOVERNANCE=
# MINIO_SECRET_ML=
# MINIO_SECRET_BI=

# --- Spark ---
# Memoria del driver (Spark corre en modo local dentro del contenedor).
SPARK_DRIVER_MEMORY=4g

# --- Logs: DEBUG, INFO, WARNING o ERROR ---
LOG_LEVEL=INFO

# --- Datos de Spotify (F2) ---
# Carpeta con los JSON reales (gitignored). En un clon sin datos se usan los sinteticos.
SPOTIFY_DATA_DIR=./DATOS_SPOTIFY

# Sal para seudonimizar ip_addr en Bronce (minimo 16 caracteres). Generala una vez y NO la cambies: si cambia,
# los hashes de IP cambian. PowerShell (la agrega a .env sin imprimirla):
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   Add-Content .env ("IP_HASH_SALT=" + (-join ($b | ForEach-Object { $_.ToString('x2') })))
# (Va comentada aqui para que el comando de arriba sea la unica definicion en tu .env.)
# IP_HASH_SALT=

# User-Agent para MusicBrainz. Vacio = uno generico del proyecto. Nunca pongas correo ni nombre personal.
MUSICBRAINZ_USER_AGENT=

# --- Orquestacion (F5) ---
# Generos en las corridas de Dagster: api (MusicBrainz, datos reales) o synthetic (datos sinteticos, sin red).
GENRES_SOURCE=api
# Puerto de la UI de Dagster en tu maquina (dentro del contenedor es 3000). Cambialo si ya esta ocupado.
DAGSTER_PORT=3300

# --- Tablero de BI (F7) ---
# Superset en http://localhost:8088, usuario admin. Llave de sesiones y contrasena del admin. PowerShell (las
# agrega a .env sin imprimirlas):
#   foreach ($v in 'SUPERSET_SECRET_KEY','SUPERSET_ADMIN_PASSWORD') {
#     $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     Add-Content .env ("$v=" + (-join ($b | ForEach-Object { $_.ToString('x2') }))) }
# Para ver la contrasena del admin: Select-String SUPERSET_ADMIN_PASSWORD .env
# (Van comentadas aqui para que el comando de arriba sea la unica definicion en tu .env.)
# SUPERSET_SECRET_KEY=
# SUPERSET_ADMIN_PASSWORD=
# Puerto de Superset en tu maquina. Cambialo si ya esta ocupado.
SUPERSET_PORT=8088
